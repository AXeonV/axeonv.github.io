<\body>
  <\wide-block>
    <tformat|<cwith|1|-1|1|-1|cell-hyphen|t>|<cwith|1|-1|1|-1|cell-halign|c>|<table|<row|<\cell>
      \;
    </cell>|<\cell>
      Analysis equation
    </cell>|<\cell>
      Synthesis equation
    </cell>|<\cell>
      Periodic?
    </cell>>|<row|<\cell>
      CTFS
    </cell>|<\cell>
      <\equation*>
        a<rsub|k>=<frac|1|T<rsub|0>><big|int><rsub|T<rsub|0>>x<around*|(|t|)>e<rsup|-j k w<rsub|0> t>\<mathd\>t
      </equation*>
    </cell>|<\cell>
      <\equation*>
        x<around*|(|t|)>=<below|<above|<big|sum>|\<infty\>>|k=-\<infty\>>a<rsub|k>e<rsup|j k \ \<omega\><rsub|0> t>
      </equation*>
    </cell>|<\cell>
      Not necessarily
    </cell>>|<row|<\cell>
      DTFS
    </cell>|<\cell>
      <\equation*>
        a<rsub|k>=<frac|1|N<rsub|0>><big|sum><rsub|n=<around*|\<langle\>|N<rsub|0>|\<rangle\>>>x<around*|[|n|]>e<rsup|-j k \<Omega\><rsub|0> n>
      </equation*>
    </cell>|<\cell>
      <\equation*>
        x<around*|[|n|]>=<below|<big|sum>|k=<around*|\<langle\>|N<rsub|0>|\<rangle\>>>a<rsub|k>e<rsup|j k \ \<Omega\><rsub|0> n>
      </equation*>
    </cell>|<\cell>
      <\equation*>
        a<rsub|k>=a<rsub|k+N<rsub|0>>
      </equation*>
    </cell>>|<row|<\cell>
      CTFT
    </cell>|<\cell>
      <\equation*>
        X<around*|(|j\<omega\>|)>=<big|int><rsup|\<infty\>><rsub|-\<infty\>>x<around*|(|t|)>e<rsup|-j\<omega\> t>\<mathd\>t
      </equation*>
    </cell>|<\cell>
      <\equation*>
        x<around*|(|t|)>=<frac|1|2\<pi\>><big|int><rsup|\<infty\>><rsub|-\<infty\>>X<around*|(|j\<omega\>|)>e<rsup|j\<omega\> t>\<mathd\>w
      </equation*>
    </cell>|<\cell>
      Not necessarily
    </cell>>|<row|<\cell>
      DTFT
    </cell>|<\cell>
      <\equation*>
        X<around*|(|e<rsup|j\<Omega\>>|)>=<below|<above|<big|sum>|\<infty\>>|n=-\<infty\>>x<around*|[|n|]>e<rsup|-j\<Omega\> n>
      </equation*>
    </cell>|<\cell>
      <\equation*>
        x<around*|[|n|]>=<frac|1|2\<pi\>><big|int><rsub|2\<pi\>>X<around*|(|j\<Omega\>|)>e<rsup|j\<Omega\> n>\<mathd\>\<Omega\>
      </equation*>
    </cell>|<\cell>
      <\equation*>
        X<around*|(|e<rsup|j\<Omega\>>|)>=X<around*|(|e<rsup|j<around*|(|\<Omega\>+2\<pi\>|)>>|)>
      </equation*>
