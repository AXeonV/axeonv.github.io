---
import { GOOGLE_SCHOLAR_URL } from '../consts';
import { conferencePublications, preprints } from '../data/publications';
import { localeFromPath } from '../lib/i18n';
import PublicationTable from './PublicationTable.astro';
const locale = localeFromPath(Astro.url.pathname);
---
{locale === 'zh' ? <p>
 我的开放获取论文可在 <a href={GOOGLE_SCHOLAR_URL} target="_blank" rel="noopener noreferrer">Alex Tianyou Liu 的 Google Scholar</a> 查阅。欢迎就我的研究与我交流，也期待潜在的合作机会。
</p> : <p>
 Browse my open-access publications on <a href={GOOGLE_SCHOLAR_URL} target="_blank" rel="noopener noreferrer">Alex Tianyou Liu’s Google Scholar</a>. If you would like to discuss my research or explore a collaboration, please get in touch.
</p>}
<h3 id="conference-journal">Conference &amp; Journal <a class="header-anchor" href="#conference-journal" aria-label={locale === 'zh' ? '链接到 Conference & Journal' : 'Link to Conference & Journal'}>​</a></h3>
<PublicationTable publications={conferencePublications} headingId="conference-journal" withVenue/>
<h3 id="preprint">Preprint <a class="header-anchor" href="#preprint" aria-label={locale === 'zh' ? '链接到 Preprint' : 'Link to Preprint'}>​</a></h3>
{preprints.length ? <PublicationTable publications={preprints} headingId="preprint"/> : <p class="alex-muted">{locale === 'zh' ? '暂无其他预印本，内容待更新。' : 'No additional preprints yet.'}</p>}
