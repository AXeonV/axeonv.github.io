---
interface Props { source: string; title: string; }
const { source, title } = Astro.props;
---
<div class="pdf-document" data-pdf={source} aria-label={title} aria-busy="true"></div>
<script>
 import { getDocument, GlobalWorkerOptions } from 'pdfjs-dist';
 import worker from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
 GlobalWorkerOptions.workerSrc = worker;
 function renderDocuments() { document.querySelectorAll<HTMLElement>('.pdf-document:not([data-render])').forEach(async host => {
  try {
   host.dataset.render = 'loading';
   const pdf = await getDocument({ url: host.dataset.pdf! }).promise;
   host.dataset.pages = String(pdf.numPages);
   const width = host.clientWidth;
   for (let number = 1; number <= pdf.numPages; number++) {
    const page = await pdf.getPage(number);
    const original = page.getViewport({ scale: 1 });
    const scale = Math.min(window.devicePixelRatio || 1, 2);
    const viewport = page.getViewport({ scale: width / original.width * scale });
    const canvas = document.createElement('canvas');
    canvas.width = Math.ceil(viewport.width); canvas.height = Math.ceil(viewport.height);
    canvas.setAttribute('role', 'img');
    const text = await page.getTextContent();
    canvas.setAttribute('aria-label', text.items.filter(item => 'str' in item).map(item => item.str).join(' '));
    await page.render({ canvas, viewport }).promise;
    host.append(canvas);
   }
   host.setAttribute('aria-busy', 'false');
   host.dataset.render = 'ready';
  } catch (error) { host.setAttribute('aria-busy', 'false'); host.dataset.render = 'error'; console.error('PDF rendering failed:', error); }
 }); }
 if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', renderDocuments, { once: true });
 else renderDocuments();
 document.addEventListener('astro:page-load', renderDocuments);
</script>
<style>
 .pdf-document { width: 100%; }
 .pdf-document :global(canvas) { display: block; width: 100%; height: auto; margin: 0 0 20px; background: white; }
</style>
