---
import { SITE_TITLE, GITHUB_URL, SIDEBAR_ENABLED } from '../consts';
import Icon from './Icon.astro';
import Search from './Search.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { localeFromPath, localePath, messages, type Translations } from '../lib/i18n';
interface Props { translations?: Translations; }
const { translations } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const text = messages[locale];
const links = [{ text: 'Article', href: localePath(locale, 'articles/') }, { text: 'Blog', href: localePath(locale, 'blog/') }, { text: 'Gallery', href: localePath(locale, 'gallery/') }];
---
<a class="skip-link" href="#VPContent">{text.skip}</a>
<header class="VPNav" data-v-ae24b3ad>
 <div class:list={['VPNavBar', { 'has-sidebar': SIDEBAR_ENABLED }]} data-v-ae24b3ad data-v-6aa21345><div class="wrapper" data-v-6aa21345><div class="container" data-v-6aa21345>
  <div class="alex-nav-left">
   <div class="title" data-v-6aa21345><div class:list={['VPNavBarTitle', { 'has-sidebar': SIDEBAR_ENABLED }]} data-v-1168a8e4><a class="title" href={localePath(locale)} data-v-1168a8e4><img class="logo" src="/favicon.svg" width="28" height="28" alt=""/><span>{SITE_TITLE}</span></a></div></div>
   <nav class="VPNavBarMenu" aria-label={text.mainNav}>{links.map(link => <a class:list={['VPNavBarMenuLink', { active: Astro.url.pathname.startsWith(link.href) }]} href={link.href} aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}>{link.text}</a>)}</nav>
  </div>
  <Search/>
  <div class="alex-nav-actions">
   <LanguageSwitch translations={translations}/>
   <button class="VPSwitch VPSwitchAppearance alex-theme" type="button" role="switch" aria-checked="false" aria-label={text.darkMode} data-v-5337faa4 data-v-1d5665e3><span class="check" data-v-1d5665e3><span class="icon" data-v-1d5665e3><span class="vpi-sun sun" data-v-5337faa4></span><span class="vpi-moon moon" data-v-5337faa4></span></span></span></button>
   <div class="VPNavBarSocialLinks"><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="Alex on GitHub"><Icon name="github" size={20}/></a></div>
   <button class="alex-menu" aria-label={text.menu} type="button" aria-expanded="false" aria-controls={SIDEBAR_ENABLED ? 'site-sidebar' : 'mobile-nav'}><Icon name="menu"/></button>
  </div>
 </div></div></div>
 {!SIDEBAR_ENABLED && <nav id="mobile-nav" class="alex-mobile-nav" aria-label={text.mobileNav} hidden>{links.map(link => <a href={link.href} aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}>{link.text}</a>)}</nav>}
</header>
<script>
 const theme = document.querySelector<HTMLButtonElement>('.alex-theme')!;
 const sync = () => theme.setAttribute('aria-checked', String(document.documentElement.classList.contains('dark')));
 sync();
 theme.addEventListener('click', () => { const dark = document.documentElement.classList.toggle('dark'); try { localStorage.setItem('alex-theme', dark ? 'dark' : 'light'); } catch {} sync(); });
 const menu = document.querySelector<HTMLButtonElement>('.alex-menu')!;
 const sidebar = document.querySelector<HTMLElement>('#site-sidebar');
 const backdrop = document.querySelector<HTMLElement>('.sidebar-backdrop');
 const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
 const setMenuOpen = (open: boolean) => {
  sidebar?.classList.toggle('open', open);
  backdrop?.classList.toggle('open', open);
  if (mobileNav) mobileNav.hidden = !open;
  menu.setAttribute('aria-expanded', String(open));
 };
 const close = () => setMenuOpen(false);
 menu.addEventListener('click', () => setMenuOpen(menu.getAttribute('aria-expanded') !== 'true'));
 backdrop?.addEventListener('click', close);
 (sidebar ?? mobileNav)?.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
 document.addEventListener('click', e => { if (mobileNav && e.target instanceof Node && !mobileNav.contains(e.target) && !menu.contains(e.target)) close(); });
 document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
</script>
