---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import CosmicGallery from '../../../components/CosmicGallery.astro';
import { LOCALES, localeFromPath } from '../../../lib/i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const zh = localeFromPath(Astro.url.pathname) === 'zh';
---
<SiteLayout title="Gallery" description={zh ? '穿越星海，探索黑洞。' : 'Travel through the starfield and explore a black hole.'} immersive><CosmicGallery/></SiteLayout>
