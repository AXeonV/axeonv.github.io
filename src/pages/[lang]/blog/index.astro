---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PostList from '../../../components/PostList.astro';
import { LOCALES, localeFromPath, messages } from '../../../lib/i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const text = messages[localeFromPath(Astro.url.pathname)];
---
<SiteLayout title="Blog">
	<header class="alex-section-header">
		<h1>Blog</h1>
		<p>{text.blogDescription}</p>
	</header>
	<PostList category="blog"/>
</SiteLayout>
