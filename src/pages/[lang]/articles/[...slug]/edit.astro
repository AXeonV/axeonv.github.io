---
import { getPublishedPosts, getPostLocale, getPostSlug, type Post } from '../../../../lib/posts';
import PostLayout from '../../../../layouts/PostLayout.astro';
export async function getStaticPaths() {
 const posts = (await getPublishedPosts('article')).filter(post => post.data.document);
 return posts.map(post => ({ params: { lang: getPostLocale(post), slug: getPostSlug(post) }, props: { post } }));
}
interface Props { post: Post; }
const { post } = Astro.props;
---
<PostLayout post={post} editing/>
