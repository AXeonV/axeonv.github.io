---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Publications from '../../components/Publications.astro';
import { EMAIL, GITHUB_URL } from '../../consts';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait1.jpg';
const toc = [
 { id: 'about-me', label: '关于我' },
 { id: 'publications', label: '学术论文' },
 { id: 'conference-journal', label: '会议与期刊', depth: 3 },
 { id: 'preprint', label: '预印本', depth: 3 },
];
---
<SiteLayout toc={toc}>
 <h1 class="profile-name">Alex Tianyou Liu <span lang="zh-CN">刘天佑</span></h1>
 <figure class="profile-photo">
  <Image src={portrait} width={240} height={320} densities={[1, 2]} alt="Alex Tianyou Liu 刘天佑的头像" class="profile-portrait" loading="eager"/>
  <figcaption>拍摄于 <time datetime="2026-08">2026 年 8 月</time></figcaption>
 </figure>
 <h2 id="about-me">关于我 <a class="header-anchor" href="#about-me" aria-label="链接到关于我">​</a></h2>
 <p>我是<strong>南方科技大学</strong>2025级深港微电子学院的本科生。</p>
 <p>专注于<strong>计算机科学与工程</strong>、<strong>微电子科学与工程</strong>、<strong>人工智能</strong>方向。最近感兴趣于 CAE（计算机辅助工程）、博弈科学、世界模型等。</p>
 <ol>
  <li><p><strong>竞赛经历：</strong>中学期间参与 NOIP 信息学奥赛，多次获得省一等奖，在竞赛学习中打下算法与编程基础。大一期间代表 Liii STEM 团队参加2026年第二十一届海峡两岸暨港澳地区大学生计算机创新作品广东省赛（AI Agent赛道），获得<a href="/certificates/cer_hxla_ai_agent.pdf" target="_blank" rel="noopener noreferrer" title="查看获奖证书（PDF）">冠军</a>。</p></li>
  <li><p><strong>开源经历：</strong>作为核心开发者为 <a href="https://github.com/MoganLab/mogan" target="_blank" rel="noopener noreferrer">Mogan</a> 项目（<a href="https://gitee.com/MoganLab/mogan" target="_blank" rel="noopener noreferrer">Gitee GVP 最有价值开源项目</a>、基于 GNU TeXmacs 的跨平台结构化科研写作套件）贡献代码，积累了大型代码库阅读、复杂系统调试、版本管理和团队协作经验。</p></li>
  <li><p><strong>实习经历：</strong>2026年暑期参与 <a href="https://summerofcode.withgoogle.com/" target="_blank" rel="noopener noreferrer">Google Summer of Code</a> 开源之夏项目<a href="/certificates/cer_GSOC.pdf" target="_blank" rel="noopener noreferrer" title="查看 GSoC 证书（PDF）">实习</a>，主要负责插件系统的开发。</p></li>
  <li><p><strong>科研经历：</strong>以一作身份完成论文 <a href="https://arxiv.org/abs/2603.02873" target="_blank" rel="noopener noreferrer">.tmu: A Low-Entropy Tree-Structured Representation for LLM-Assisted Scientific Writing</a>，已被 EMNLP 会议录用。</p></li>
 </ol>
 <p>邮箱：<a href={`mailto:${EMAIL}`}>{EMAIL}</a><br/>GitHub：<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">github.com/AXeonV</a></p>
 <h2 id="publications">学术论文 <a class="header-anchor" href="#publications" aria-label="链接到学术论文">​</a></h2>
 <Publications/>
</SiteLayout>
