---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
 title="404 · 页面未找到 / Page not found"
 description="页面不存在或已移动。The page does not exist or has moved."
 translations={{ zh: '/zh/', en: '/en/' }}
>
 <section class="not-found">
  <img src="/favicon.svg" width="112" height="112" alt="Alex Tianyou Liu 的黑洞图标"/>
  <p class="error-code">404</p>
  <h1>页面未找到 / Page not found</h1>
  <p>页面不存在或已移动。<br/>The page does not exist or has moved.</p>
  <div class="home-links"><a href="/zh/">返回首页</a><a href="/en/">Back to home</a></div>
 </section>
</SiteLayout>
<style>
 .not-found { padding: 48px 0 64px; text-align: center; }
 .not-found img { display: block; margin: 0 auto 24px; }
 .not-found .error-code { margin: 0 0 16px; font-size: 64px; font-weight: 600; line-height: 1; color: var(--vp-c-brand-1); }
 .not-found h1 { font-size: clamp(1.5rem, 3vw, 2rem); }
 .not-found p { color: var(--vp-c-text-2); }
 .home-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; margin-top: 24px; }
</style>
